{
  "name": "@deepseek-ai/dsh-cicada-runtime",
  "description": "Schematic-Cicada runtime: the eight producer write tools, turn session (native-CAS commit, worksite lock, oplog, changelog), role-scoped tool injection, and the error-code single authority",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
